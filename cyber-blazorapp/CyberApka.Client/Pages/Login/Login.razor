@page "/login"
@page "/"

@using CyberApka.Client.Services
@using Microsoft.AspNetCore.Components.Authorization
@using MudBlazor
@using CyberApka.Shared.Requests
@inject AuthService AuthService
@inject ISnackbar Snackbar
@inject IJSRuntime JS
@inject NavigationManager NavigationManager
@inject AuthenticationStateProvider AuthStateProvider

<MudPaper Class="mx-auto mt-12 pa-6" MaxWidth="400px" Elevation="10">
    <div class="d-flex flex-column align-end w-100 mb-4">
        <MudText Typo="Typo.caption" Class="mb-1">Nie masz jeszcze konta?</MudText>
        <MudButton Variant="Variant.Outlined"
                   Color="Color.Secondary"
                   Size="Size.Small"
                   OnClick="@RedirectRegister">
            Zarejestruj się
        </MudButton>
    </div>

    <div>
        <div class="d-flex justify-center align-center mb-6">
            <MudIcon Icon="@Icons.Material.Filled.Login" Size="Size.Large" Color="Color.Primary" Class="mr-2" />
            <MudText Typo="Typo.h5">Logowanie</MudText>
        </div>

        <EditForm Model="@_request" OnValidSubmit="ValidateUser">
            <DataAnnotationsValidator />
            <ValidationSummary />

            <MudTextField @bind-Value="_request.Email"
                          Label="Email"
                          Required="true"
                          Variant="Variant.Outlined"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Email"
                          Class="mb-3" />

            <MudTextField @bind-Value="_request.Password"
                          Label="Hasło"
                          InputType="InputType.Password"
                          Required="true"
                          Variant="Variant.Outlined"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Lock" />

            <MudContainer Class="px-0 mt-4">
                <div id="login-recaptcha-container" @key="@("login-recaptcha")"></div>
            </MudContainer>

            <MudButton ButtonType="ButtonType.Submit"
                       Variant="Variant.Filled"
                       Color="Color.Primary"
                       Class="mt-6 py-2"
                       FullWidth="true"
                       Size="Size.Large">
                Zaloguj się
                <MudIcon Icon="@Icons.Material.Filled.ArrowForward" Size="Size.Medium" Color="Color.Inherit" Class="ml-2" />
            </MudButton>

            @if (_message is not null)
            {
                <MudAlert Severity="@(_isError? Severity.Error: Severity.Success)" Class="mt-3" Dense="true">
                    @_message
                </MudAlert>
            }
        </EditForm>
    </div>
</MudPaper>

@code {
    private LoginRequest _request = new();
    private string? _message;
    private bool _isError;
    private const string SiteKey = "6Lcwpg0sAAAAABpF5jSbZZGWJO4KMo0HDMSBMcuf";

    private void RedirectRegister() { NavigationManager.NavigateTo("/register"); }
    private void RedirectRecover() { NavigationManager.NavigateTo("/recoverAccount"); }

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (user.Identity is not null && user.Identity.IsAuthenticated)
        {
            NavigationManager.NavigateTo("/dashboard");
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await Task.Delay(500);
            try
            {
                await JS.InvokeVoidAsync("renderRecaptcha", "login-recaptcha-container", SiteKey);
            }
            catch (Exception ex)
            {
                Console.WriteLine("Login Recaptcha render error: " + ex.Message);
            }
        }
    }

    private async Task ValidateUser()
    {
        try
        {
            _request.CaptchaToken = await JS.InvokeAsync<string>("getRecaptchaResponse");
        }
        catch
        {
            _request.CaptchaToken = await JS.InvokeAsync<string>("grecaptcha.getResponse");
        }

        if (string.IsNullOrEmpty(_request.CaptchaToken))
        {
            Snackbar.Add("Poteiwrdź, że nie jesteś robotem", Severity.Error);
            return;
        }

        var result = await AuthService.LoginAsync(_request);

        if (result.IsSuccess)
        {
            Snackbar.Add("Pomyślnie zalogowano", Severity.Success);
            NavigationManager.NavigateTo("/dashboard");
        }
        else
        {
            Snackbar.Add(result.ErrorMessage ?? "Unknown error", Severity.Error);
        }
    }
}