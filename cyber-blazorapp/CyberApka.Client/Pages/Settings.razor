@page "/settings"
@using CyberApka.Client.Components
@using Microsoft.AspNetCore.Authorization
@using CyberApka.Shared.Results
@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@using MudBlazor
@attribute [Authorize]

@inject AuthenticationStateProvider AuthStateProvider
@inject HttpClient Http
@inject ISnackbar Snackbar

<PageTitle>Ustawienia</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-4">
	<MudText Typo="Typo.h4" Class="mb-4">
		<MudIcon Icon="@Icons.Material.Filled.Settings" Size="Size.Large" Class="mr-2" />
		Ustawienia Systemu
	</MudText>

	<MudTabs Elevation="2" Rounded="true" ApplyEffectsToContainer="true" PanelClass="pa-6">

		<MudTabPanel Text="Mój Profil" Icon="@Icons.Material.Filled.Person">
			<MudGrid>
				<MudItem xs="12" md="6">
					<MudPaper Class="pa-4" Elevation="3">
						<MudText Typo="Typo.h6" GutterBottom="true">Dane użytkownika</MudText>
						<MudDivider Class="mb-4" />

						<MudTextField Label="Email" Value="@_userEmail" ReadOnly="true" Variant="Variant.Outlined" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Email" />
						<MudTextField Label="Rola" Value="@_userRole" ReadOnly="true" Variant="Variant.Outlined" Class="mt-3" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Security" />
					</MudPaper>
				</MudItem>
			</MudGrid>
		</MudTabPanel>

		<MudTabPanel Text="Bezpieczeństwo" Icon="@Icons.Material.Filled.Lock">
			<MudText Typo="Typo.body1">Tutaj w przyszłości dodamy zmianę hasła.</MudText>
			<MudButton Variant="Variant.Outlined" Color="Color.Primary" Class="mt-2" Disabled="true">Zmień hasło (Wkrótce)</MudButton>
		</MudTabPanel>

		<PermissionView Required="Settings.Manage">
			<MudTabPanel Text="Administracja" Icon="@Icons.Material.Filled.AdminPanelSettings" BadgeData='"!"' BadgeColor="Color.Error">
				<MudPaper Class="pa-4 border-solid border-2 mud-border-error" Elevation="0">
					<MudText Typo="Typo.h6" Color="Color.Error">Strefa Niebezpieczna (Dev Tools)</MudText>
					<MudText Typo="Typo.body2" Class="mb-4">Narzędzia techniczne do zarządzania aplikacją.</MudText>

					<MudDivider Class="mb-4" />

					<div class="d-flex align-center">
						<div>
							<MudText Typo="Typo.subtitle1">Synchronizacja Uprawnień</MudText>
							<MudText Typo="Typo.caption">Skanuje kod w poszukiwaniu nowych stałych Permissions i dodaje je do bazy (Rola ID=3).</MudText>
						</div>
						<MudSpacer />
						<MudButton Variant="Variant.Filled"
								   Color="Color.Warning"
								   OnClick="SyncPermissions"
								   StartIcon="@Icons.Material.Filled.Sync"
								   Size="Size.Large">
							Synchronizuj
						</MudButton>
					</div>
				</MudPaper>
			</MudTabPanel>
		</PermissionView>

	</MudTabs>
</MudContainer>

@code {
	private string _userEmail = string.Empty;
	private string _userRole = string.Empty;

	protected override async Task OnInitializedAsync()
	{
		var state = await AuthStateProvider.GetAuthenticationStateAsync();
		var user = state.User;

		if (user.Identity?.IsAuthenticated == true)
		{
			_userEmail = user.FindFirst(ClaimTypes.Email)?.Value ?? "Nieznany";
			_userRole = user.FindFirst(ClaimTypes.Role)?.Value ?? "User";
		}
	}

	private async Task SyncPermissions()
	{
		var response = await Http.PostAsync("/api/admin/sync-permissions", null);

		if (response.IsSuccessStatusCode)
		{
			var result = await response.Content.ReadFromJsonAsync<CyberApkaResult<string>>();
			if (result != null && result.IsSuccess)
			{
				Snackbar.Add(result.Data, Severity.Success);
			}
			else
			{
				Snackbar.Add(result?.ErrorMessage ?? "Błąd logiczny serwera", Severity.Error);
			}
		}
		else
		{
			Snackbar.Add($"Błąd połączenia: {response.StatusCode}", Severity.Error);
		}
	}
}