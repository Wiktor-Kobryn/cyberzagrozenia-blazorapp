@page "/register"
@inject AuthService AuthService
@inject ISnackbar Snackbar
@using CyberApka.Client.Services
@using CyberApka.Shared.Requests
@using MudBlazor
@inject NavigationManager NavigationManager
@inject IJSRuntime JS

<MudPaper Class="mx-auto mt-12 pa-6" MaxWidth="400px" Elevation="10">
    <div class="d-flex flex-column align-end w-100 mb-2">
        <MudText class="mb-1">Already have an account?</MudText>
        <MudButton Variant="Variant.Outlined" Color="Color.Secondary" OnClick="@RedirectLogin">Sign In</MudButton>
    </div>

    <div>
        <MudText Typo="Typo.h5" Class="mb-4">
            <MudIcon Icon="@Icons.Material.Filled.AccountCircle" Size="Size.Large" Color="Color.Primary" Class="mb-1" />
            Sign Up
        </MudText>

        <EditForm Model="@_request" OnValidSubmit="RegisterUser">
            <DataAnnotationsValidator />
            <ValidationSummary />

            <MudTextField @bind-Value="_request.Username" Label="Username" Required="true" />
            <MudTextField @bind-Value="_request.Email" Label="Email" Required="true" InputType="InputType.Email"/>
            <MudTextField @bind-Value="_request.Password" Label="Password" InputType="InputType.Password" Required="true" />
            <MudTextField @bind-Value="repeatedPassword" Label="Repeat password" InputType="InputType.Password" Required="true" />

            <MudContainer Style="margin-top: 20px;">
                <div id="register-recaptcha-container" @key="@("recaptcha-div")"></div>
            </MudContainer>

            <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" Class="mt-4" FullWidth="true">
                Register
                <MudIcon Icon="@Icons.Material.Filled.ChevronRight" Size="Size.Large" Color="Color.Primary" Class="mb-1" />
            </MudButton>
        </EditForm>
    </div>
</MudPaper>

@code {
    private RegisterRequest _request = new();
    private string repeatedPassword = "";
    private const string SiteKey = "6Lcwpg0sAAAAABpF5jSbZZGWJO4KMo0HDMSBMcuf";

    private void RedirectLogin() { NavigationManager.NavigateTo("/login"); }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await Task.Delay(500);
            try
            {
                await JS.InvokeVoidAsync("renderRecaptcha", "register-recaptcha-container", SiteKey);
            }
            catch (Exception ex)
            {
                Console.WriteLine("Recaptcha render error: " + ex.Message);
            }
        }
    }

    private bool CheckPasswordIntegrity()
    {
        if (_request.Password != repeatedPassword)
        {
            Snackbar.Add("Password does not match", Severity.Error);
            _request.Password = "";
            repeatedPassword = "";
            return false;
        }
        return true;
    }

    private async Task RegisterUser()
    {
        if (!CheckPasswordIntegrity()) return;
        try
        {
            _request.CaptchaToken = await JS.InvokeAsync<string>("getRecaptchaResponse");
        }
        catch
        {
            _request.CaptchaToken = await JS.InvokeAsync<string>("grecaptcha.getResponse");
        }

        if (string.IsNullOrEmpty(_request.CaptchaToken))
        {
            Snackbar.Add("Please complete the captcha", Severity.Error);
            return;
        }

        var result = await AuthService.RegisterAsync(_request);

        if (result.IsSuccess)
        {
            Snackbar.Add("Successfully registered", Severity.Success);
            NavigationManager.NavigateTo("/login");
        }
        else
        {
            Snackbar.Add(result.ErrorMessage ?? "Unknown error", Severity.Error);
        }
    }
}