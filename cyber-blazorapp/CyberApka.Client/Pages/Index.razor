@page "/"
@using MudBlazor
@inject NavigationManager NavigationManager

<MudPaper Height="400px" Width="100%" Class="d-flex justify-center align-center">
    <MudContainer MaxWidth="MaxWidth.Small" Class="d-flex flex-column align-center">
        <MudStack Spacing="2">
            <MudIcon Icon="@Icons.Material.Filled.AccountCircle" Size="Size.Large" Color="Color.Primary" Class="mb-4" Style="font-size:200px;" />
            <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" onclick="@RedirectLogin">Sign In</MudButton>
            <MudButton Variant="Variant.Outlined" Color="Color.Secondary" FullWidth="true" onclick="@RedirectRegister">Sign Up</MudButton>
        </MudStack>
    </MudContainer>
</MudPaper>

@code {
    private void RedirectRegister() { NavigationManager.NavigateTo("/register"); }
    private void RedirectLogin() { NavigationManager.NavigateTo("/login"); }
}