@page "/recoverAccount"

@using CyberApka.Client.Services
@using MudBlazor
@using CyberApka.Shared.Requests
@inject RecoveryService RecoveryService
@inject ISnackbar Snackbar
@inject IJSRuntime JS
@inject NavigationManager NavigationManager

<head><script src="https://www.google.com/recaptcha/api.js" async defer></script></head>

<MudPaper Class="mx-auto mt-12 pa-6" MaxWidth="400px" Elevation="10">
    <div class="d-flex flex-column align-end w-100 mb-2">
        <MudStack Spacing="2">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" onclick="@RedirectLogin">Sign In</MudButton>
            <MudButton Variant="Variant.Outlined" Color="Color.Secondary" FullWidth="true" onclick="@RedirectRegister">Sign Up</MudButton>
        </MudStack>
    </div>

    <div>
        <MudText Typo="Typo.h5" Class="mb-4">
            <MudIcon Icon="@Icons.Material.Filled.AccountCircle" Size="Size.Large" Color="Color.Primary" Class="mb-1" />
            Recover Account
        </MudText>

        <EditForm Model="@_request" OnValidSubmit="SendRecoveryEmail">
            <DataAnnotationsValidator />
            <ValidationSummary />

            <MudTextField @bind-Value="_request.Email" Label="Email" Required="true" />
            
            <MudContainer Style="margin-top: 20px;">
                <div id="loginRecaptcha" class="g-recaptcha" data-sitekey="6Lcwpg0sAAAAABpF5jSbZZGWJO4KMo0HDMSBMcuf"></div>
            </MudContainer>

            <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" Class="mt-4" FullWidth="true">
                Send Code
                <MudIcon Icon="@Icons.Material.Filled.ChevronRight" Size="Size.Large" Color="Color.Primary" Class="mb-1" />
            </MudButton>

            @if (_message is not null)
            {
                <MudText Class="mt-3" Color="@(_isError? Color.Error: Color.Success)">@_message</MudText>
            }
        </EditForm>

        <div class="d-flex flex-column align-center">
            <MudText Typo="Typo.h6" Class="mb-3">Recovery Code:</MudText>

            <MudTextField @bind-Value="_recoveryCode"
                          MaxLength="6"
                          Style="letter-spacing: .6rem; font-size: 24px; text-align: center; padding-left: 12px;" />
        </div>
    </div>
</MudPaper>


@code {
    private RecoveryEmailRequest _request = new();
    private string? _message;
    private bool _isError;
    private string _recoveryCode;

    private void RedirectRegister() { NavigationManager.NavigateTo("/register"); }
    private void RedirectLogin() { NavigationManager.NavigateTo("/login"); } 

    private async Task SendRecoveryEmail()
    {
        _request.CaptchaToken = await JS.InvokeAsync<string>("grecaptcha.getResponse", 0);
        if (string.IsNullOrEmpty(_request.CaptchaToken))
        {
            Snackbar.Add("Please complete the captcha", Severity.Error);
            return;
        }

        var result = await RecoveryService.SendRecoveryEmailAsync(_request);

        if (result.IsSuccess)
        {
            Snackbar.Add("Recovery code sent via email", Severity.Success);
        }
        else
        {
            Snackbar.Add(result.ErrorMessage ?? "Unknown error", Severity.Error);
        }
    }
}