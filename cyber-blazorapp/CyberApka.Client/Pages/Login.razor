@page "/login"
@page "/"

@using CyberApka.Client.Services
@using Microsoft.AspNetCore.Components.Authorization
@using MudBlazor
@using CyberApka.Shared.Requests
@inject AuthService AuthService
@inject ISnackbar Snackbar
@inject IJSRuntime JS
@inject NavigationManager NavigationManager
@inject AuthenticationStateProvider AuthStateProvider

<MudPaper Class="mx-auto mt-12 pa-6" MaxWidth="400px" Elevation="10">
    <div class="d-flex flex-column align-end w-100 mb-2">
        <MudText class="mb-1">Don't have an account?</MudText>
        <MudButton Variant="Variant.Outlined" Color="Color.Secondary" OnClick="@RedirectRegister">Sign Up</MudButton>
    </div>

    <div>
        <MudText Typo="Typo.h5" Class="mb-4">
            <MudIcon Icon="@Icons.Material.Filled.AccountCircle" Size="Size.Large" Color="Color.Primary" Class="mb-1" /> Sign In
        </MudText>

        <EditForm Model="@_request" OnValidSubmit="ValidateUser">
            <DataAnnotationsValidator />
            <ValidationSummary />

            <MudTextField @bind-Value="_request.Email" Label="Email" Required="true" />
            <MudTextField @bind-Value="_request.Password" Label="Password" InputType="InputType.Password" Required="true" />

            <MudContainer Style="margin-top: 20px;">
                <div id="login-recaptcha-container" @key="@("login-recaptcha")"></div>
            </MudContainer>

            <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" Class="mt-4" FullWidth="true">Login <MudIcon Icon="@Icons.Material.Filled.ChevronRight" Size="Size.Large" Color="Color.Primary" Class="mb-1" /></MudButton>

            @if (_message is not null)
            {
                <MudText Class="mt-3" Color="@(_isError? Color.Error: Color.Success)">@_message</MudText>
            }
        </EditForm>
    </div>

    <div class="d-flex flex-column align-start w-100 mb-2 mt-4">
        <MudText class="mb-1">Forgot your password?</MudText>
        <MudButton Variant="Variant.Outlined" Color="Color.Secondary" OnClick="@RedirectRecover">Recover account</MudButton>
    </div>
</MudPaper>


@code {
    private LoginRequest _request = new();
    private string? _message;
    private bool _isError;
    private const string SiteKey = "6Lcwpg0sAAAAABpF5jSbZZGWJO4KMo0HDMSBMcuf";

    private void RedirectRegister() { NavigationManager.NavigateTo("/register"); }
    private void RedirectRecover() { NavigationManager.NavigateTo("/recoverAccount"); }

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (user.Identity is not null && user.Identity.IsAuthenticated)
        {
            NavigationManager.NavigateTo("/dashboard");
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await Task.Delay(500);
            try
            {
                await JS.InvokeVoidAsync("renderRecaptcha", "login-recaptcha-container", SiteKey);
            }
            catch (Exception ex)
            {
                Console.WriteLine("Login Recaptcha render error: " + ex.Message);
            }
        }
    }

    private async Task ValidateUser()
    {
        try
        {
            _request.CaptchaToken = await JS.InvokeAsync<string>("getRecaptchaResponse");
        }
        catch
        {
            _request.CaptchaToken = await JS.InvokeAsync<string>("grecaptcha.getResponse");
        }

        if (string.IsNullOrEmpty(_request.CaptchaToken))
        {
            Snackbar.Add("Please complete the captcha", Severity.Error);
            return;
        }

        var result = await AuthService.LoginAsync(_request);

        if (result.IsSuccess)
        {
            Snackbar.Add("Successfully logged", Severity.Success);
            NavigationManager.NavigateTo("/dashboard");
        }
        else
        {
            Snackbar.Add(result.ErrorMessage ?? "Unknown error", Severity.Error);
        }
    }
}