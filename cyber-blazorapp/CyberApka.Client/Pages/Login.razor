@page "/login"

@using CyberApka.Client.Services
@using MudBlazor
@using CyberApka.Shared.Requests
@inject AuthService AuthService
@inject ISnackbar Snackbar
@inject IJSRuntime JS
@inject NavigationManager NavigationManager

<head><script src="https://www.google.com/recaptcha/api.js" async defer></script></head>
<MudPaper Class="mx-auto mt-12 pa-6" MaxWidth="400px" Elevation="10">
    <MudText Typo="Typo.h5" Class="mb-4">
        <MudIcon Icon="@Icons.Material.Filled.AccountCircle" Size="Size.Large" Color="Color.Primary" Class="mb-1" />
        Sign In
    </MudText>
    <EditForm Model="@_request" OnValidSubmit="ValidateUser">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <MudTextField @bind-Value="_request.Email" Label="Email" Required="true" />
        <MudTextField @bind-Value="_request.Password" Label="Password" InputType="InputType.Password" Required="true" />
        <MudContainer Style="margin-top: 20px;">
            <div id="loginRecaptcha" class="g-recaptcha" data-sitekey="6Lcwpg0sAAAAABpF5jSbZZGWJO4KMo0HDMSBMcuf"></div>
        </MudContainer>

        <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" Class="mt-4" FullWidth="true">
            Login 
            <MudIcon Icon="@Icons.Material.Filled.ChevronRight" Size="Size.Large" Color="Color.Primary" Class="mb-1" />
        </MudButton>

        @if (_message is not null)
        {
            <MudText Class="mt-3" Color="@(_isError? Color.Error: Color.Success)">@_message</MudText>
        }
    </EditForm>
</MudPaper>

@code {
    private LoginRequest _request = new();
    private string? _message;
    private bool _isError;

    private async Task ValidateUser()
    {
        _request.CaptchaToken = await JS.InvokeAsync<string>("grecaptcha.getResponse", 0);
        if (string.IsNullOrEmpty(_request.CaptchaToken))
        {
            Snackbar.Add("Please complete the captcha", Severity.Error);
            return;
        }

        var result = await AuthService.LoginAsync(_request);

        if (result.IsSuccess)
        {
            Snackbar.Add("Successfully logged", Severity.Success);
            NavigationManager.NavigateTo("/dashboard");
        }
        else
        {
            Snackbar.Add(result.ErrorMessage ?? "Unknown error", Severity.Error);
        }

    }
    
}