@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@inject AuthenticationStateProvider AuthStateProvider

@if (_hasPermission)
{
    @(Authorized ?? ChildContent)
}
else
{
    @NotAuthorized
}

@code {
    [Parameter, EditorRequired] public string Required { get; set; } = string.Empty;
    [Parameter] public RenderFragment? Authorized { get; set; }
    [Parameter] public RenderFragment? NotAuthorized { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private bool _hasPermission;

    protected override async Task OnParametersSetAsync()
    {
        var state = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = state.User;

        if (user.Identity?.IsAuthenticated == true)
        {
            _hasPermission = user.HasClaim(c => c.Type == "permission" && c.Value == Required);
        }
        else
        {
            _hasPermission = false;
        }
    }
}