{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Server",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build server",
            "program": "${workspaceFolder}/CyberApka.Server/bin/Debug/net9.0/CyberApka.Server.dll",
            "args": [],
            "cwd": "${workspaceFolder}/CyberApka.Server",
            "stopAtEntry": false,
            "env": {
                "ASPNETCORE_ENVIRONMENT": "Development",
                "ASPNETCORE_URLS": "https://localhost:7226;http://localhost:5027"
            },
            "sourceFileMap": {
                "/Views": "${workspaceFolder}/Views"
            },
            "justMyCode": true,
            "suppressJITOptimizations": true
        },
        {
            "name": "Client",
            "type": "msedge",
            "request": "launch",
            "preLaunchTask": "serve client",
            "url": "https://localhost:7106",
            "webRoot": "${workspaceFolder}/CyberApka.Client/wwwroot",
            "timeout": 30000
        }
    ],
    "compounds": [
        {
            "name": "Full Stack Debug",
            "configurations": [
                "Server",
                "Client"
            ],
            "stopAll": true
        }
    ]
}